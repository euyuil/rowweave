{
  "name": "rowweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc && node scripts/build-renderer.mjs",
    "test": "npm run build && node --test \"dist/**/tests/*.test.js\"",
    "start:server": "node dist/apps/server/src/cli.js",
    "setup:desktop": "install-electron",
    "start": "npm run build && npm run setup:desktop && electron .",
    "test:desktop": "npm run build && npm run setup:desktop && node apps/desktop/tests/smoke.mjs"
  },
  "main": "dist/apps/desktop/src/main.js",
  "overrides": {
    "@linaria/react": { "minimatch": "11.0.1" },
    "@linaria/utils": { "minimatch": "11.0.1" }
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "electron": "45.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "6.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
